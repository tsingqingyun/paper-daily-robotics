version = 1
id = "ai"
kind = "cron"
name = "AI and embodied intelligence daily update"
prompt = "In the configured Obsidian vault, run the canonical entry point `/bin/zsh scripts/run_ai_daily.sh`. Verify the generated digest, `state/seen.json`, the vault link gate, `state/ai-daily.publish.json`, and that the publication mirror HEAD matches origin/main. Report candidate and selected counts, top title, concepts, feed failures, link status, repository, publication status, and commit SHA. Do not delete files."
status = "ACTIVE"
rrule = "FREQ=DAILY;BYHOUR=8;BYMINUTE=10"
execution_environment = "local"
cwds = ["/path/to/your/obsidian-vault"]
